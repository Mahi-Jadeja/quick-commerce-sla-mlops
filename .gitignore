# Byte-compiled / cache
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Virtual environment
venv/
.venv/

# Environment variables
.env

# Logs
logs/*.log

# Local MLflow tracking data
mlruns/
mlartifacts/

# Data (tracked via DVC, not git)
data/raw/*
!data/raw/.gitignore
data/processed/*
!data/processed/.gitkeep

# Models (tracked via DVC, not git)
models/*
!models/.gitkeep
!models/*.dvc

# OS files
.DS_Store
