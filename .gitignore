# Python / Cache
venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# Environment & Secrets
.env
*.pem
kaggle.json

# Data & ML Artifacts (managed by DVC)
data/raw/*
!data/raw/.gitignore
!data/raw/*.dvc
data/processed/*
!data/processed/.gitkeep

# Models (managed by DVC)
models/*
!models/.gitkeep
!models/*.dvc

# Local MLflow tracking
mlruns/
mlartifacts/

# IDE & OS
.vscode/
.idea/
*.swp
.DS_Store

# Logs
logs/*.log
